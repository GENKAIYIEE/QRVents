generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  DEPT_ADMIN
  STUDENT
}

enum EventType {
  SCHOOL_WIDE
  DEPARTMENT
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  APPROVED
  ON_HOLD
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  GUEST
  CHECKED_OUT
}

enum PenaltyType {
  FEE
  COMMUNITY_SERVICE
}

enum PenaltyStatus {
  PENDING
  OVERDUE
  RESOLVED
  WAIVED
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  color     String   @default("#1A3A8F")
  lightBg   String   @default("#EEF2FF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  events    Event[]
  proposals EventProposal[]

  @@map("departments")
}

model User {
  id           String      @id @default(uuid())
  fullName     String
  email        String      @unique
  passwordHash String
  role         Role        @default(STUDENT)
  studentId    String?     @unique
  yearLevel    String?
  section      String?
  qrCode       String?     @unique
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  attendanceLogs    AttendanceLog[]
  proposals         EventProposal[]
  notifications     Notification[]
  penalties         Penalty[] @relation("StudentPenalties")
  resolvedPenalties Penalty[] @relation("PenaltyResolver")

  @@index([departmentId])
  @@map("users")
}

model Event {
  id                String      @id @default(uuid())
  title             String
  description       String?
  date              DateTime
  startTime         String
  endTime           String
  venue             String
  eventType         EventType   @default(SCHOOL_WIDE)
  status            EventStatus @default(UPCOMING)
  isMandatory       Boolean     @default(false)
  hasCertificate    Boolean     @default(false)
  penaltiesGenerated Boolean    @default(false)
  isArchived        Boolean     @default(false)
  expectedAttendees Int?
  createdById       String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])

  attendanceLogs AttendanceLog[]
  proposal       EventProposal?
  penalties      Penalty[]

  @@index([departmentId])
  @@index([createdById])
  @@map("events")
}

model EventProposal {
  id              String         @id @default(uuid())
  title           String
  description     String?
  date            DateTime
  startTime       String
  endTime         String
  venue           String
  status          ProposalStatus @default(PENDING)
  rejectionReason String?
  isPublished     Boolean        @default(false)
  hasCertificate  Boolean        @default(false)
  isArchived      Boolean        @default(false)
  submittedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  updatedAt       DateTime       @updatedAt
  submittedById   String
  submittedBy     User           @relation(fields: [submittedById], references: [id])
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id])
  eventId         String?        @unique
  event           Event?         @relation(fields: [eventId], references: [id])

  @@index([submittedById])
  @@index([departmentId])
  @@map("event_proposals")
}

model AttendanceLog {
  id        String           @id @default(uuid())
  checkIn   DateTime         @default(now())
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  isLate    Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("attendance_logs")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model ScannerPin {
  id        String   @id @default(uuid())
  userId    String   @unique
  pinHash   String
  updatedAt DateTime @updatedAt

  @@map("scanner_pins")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("activity_logs")
}

model SystemSettings {
  id                  String   @id @default("global")
  defaultScanDuration Int      @default(120)  // seconds before scanner auto-locks
  autoLogoutTimer     Int      @default(5)    // minutes of inactivity before logout
  updatedAt           DateTime @updatedAt

  @@map("system_settings")
}

model Penalty {
  id           String        @id @default(uuid())
  studentId    String
  student      User          @relation("StudentPenalties", fields: [studentId], references: [id])
  eventId      String
  event        Event         @relation(fields: [eventId], references: [id])
  type         PenaltyType?
  reason       String?       // ABSENT | LATE | NO_CHECKOUT | LATE_AND_NO_CHECKOUT
  status       PenaltyStatus @default(PENDING)
  feeAmount    Float
  serviceHours Int
  deadline     DateTime
  resolvedById String?
  resolvedBy   User?         @relation("PenaltyResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([studentId, eventId])
  @@index([eventId])
  @@map("penalties")
}

model PenaltySettings {
  id                   String   @id @default(uuid())
  defaultDeadlineDays  Int      @default(7)
  defaultFee           Float    @default(100)
  defaultServiceHours  Int      @default(2)
  overdueFeeIncrease   Float    @default(50)
  overdueHoursIncrease Int      @default(1)
  updatedAt            DateTime @updatedAt

  @@map("penalty_settings")
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique           // SHA-256 hash of the session token returned to client
  otpHash     String                     // SHA-256 hash of the 6-digit OTP sent to email
  userId      String
  expiresAt   DateTime                   // 10 minutes from creation
  otpVerified Boolean  @default(false)   // true after user verifies the OTP
  used        Boolean  @default(false)   // true after password has been reset
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

